{
  "name": "mambo-sound-smash-button",
  "displayName": "mambo-sound-smash-button",
  "description": "Wipe away your stressful with mambo sound",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": ["Other"],
  "activationEvents": [
    "onView:myExtensionSidebar"
  ],
  "main": "./out/extension.js",
  "contributes": {
     "viewsContainers": {
      "activitybar": [
        {
          "id": "mamboSoundSmashButton",
          "title": "Mambo Smash",
          "icon": "resources/icons.svg"
        }
      ]
    },
    "views": {
      "mamboSoundSmashButton": [
        {
          "id": "mamboSoundSmashButton.view",
          "name": "Smash Button",
          "type": "webview"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "yarn run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "yarn run compile && yarn run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.125.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}